<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- UserDefaults: used to persist the visitor passport token, cached targeting data, and ID5 signature -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>

    <!--
        NSPrivacyTracking: false — the SDK collects data on a first-party basis on behalf of the
        integrating publisher. Data is sent to the publisher's own Optable DCN, not shared with
        third parties for advertising measurement or cross-app tracking.

        NOTE: If your integration uses the Apple IDFA (skipAdvertisingIdDetection = false), you
        must still request ATT authorization via ATT.requestATTAuthorization() before the IDFA
        will be available. This manifest entry does not remove that requirement — it only means
        the OS will not block network requests to the edge domain based on ATT status.
    -->
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array>

        <!--
            Apple IDFA — automatically prepended when ATT is authorized and
            skipAdvertisingIdDetection is false. Collected for first-party audience assembly.
            Mark NSPrivacyCollectedDataTypeTracking as true here if your integration uses the
            IDFA for cross-app or cross-site tracking.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeFirstPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- Hashed email address (SHA-256), sent via OptableIdentifier.emailAddress / .hem -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeFirstPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- Hashed phone number (SHA-256), sent via OptableIdentifier.phoneNumber / .hashedPhoneNumber -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhoneNumber</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeFirstPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- App events logged via the witness() API (e.g. screen views, button presses) -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeFirstPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!--
            ID5 signature — received from the DCN in a targeting/profile response and automatically
            re-sent on subsequent targeting calls as an id5_signature query parameter. The signature
            flows only between this app and the publisher's own Optable DCN; no cross-publisher
            matching occurs on-device. Marked tracking: false on that basis.

            Note: if the integrating DCN is configured to perform cross-publisher ID5 resolution,
            the app's own privacy manifest should assess whether a tracking: true declaration is
            warranted for that deployment.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeFirstPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!--
            Other first-party identifiers: postal code, custom IDs, optableVID.
            Cross-publisher identifiers (ID5, netID, UTIQ) are not declared here — they are only
            sent when explicitly passed by the integrating app, making them the app's responsibility
            to declare in its own privacy manifest.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeFirstPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

    </array>
</dict>
</plist>
